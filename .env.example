# Example environment for docker compose / local debug.
# Copy to .env and fill in secrets. Never commit .env.

# --- Gateway ---
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
# Present as header X-API-Key (or Authorization: Bearer …). Empty disables auth.
GATEWAY_API_KEY=change-me
GATEWAY_INGESTION_GRPC_ADDR=ingestion:50051
GATEWAY_RAG_GRPC_ADDR=rag_orchestrator:50052
GATEWAY_LITELLM_BASE_URL=http://litellm:4000

# --- Ingestion ---
INGESTION_GRPC_HOST=0.0.0.0
INGESTION_GRPC_PORT=50051
INGESTION_QDRANT_HOST=qdrant
INGESTION_QDRANT_GRPC_PORT=6334
INGESTION_LITELLM_BASE_URL=http://litellm:4000
INGESTION_EMBEDDING_MODEL_ALIAS=embedder-default
INGESTION_LOCAL_FILES_DIR=/data/local_files
LOCAL_FILES_DIR=./data/local_files

# --- RAG Orchestrator ---
RAG_GRPC_HOST=0.0.0.0
RAG_GRPC_PORT=50052
RAG_QDRANT_HOST=qdrant
RAG_QDRANT_HTTP_PORT=6333
RAG_QDRANT_GRPC_PORT=6334
RAG_LITELLM_BASE_URL=http://litellm:4000
RAG_LITELLM_API_KEY=sk-ragvalod-local
RAG_EMBEDDING_MODEL_ALIAS=embedder-default
RAG_EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
RAG_EMBEDDING_QUERY_PREFIX="query: "
RAG_RERANKER_MODEL_ALIAS=reranker-default
RAG_CHAT_MODEL_ALIAS=chat-default

# --- LiteLLM (stage 3+) ---
# Chat backend: OpenRouter (preferred) and/or OpenAI-compatible keys.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
LITELLM_MASTER_KEY=sk-ragvalod-local
LITELLM_BASE_URL=http://localhost:4000

# --- Notion (stage 7+) ---
# Used only by host-side scripts / manual curls. Services take the token
# per-request via POST /ingest credentials (not from this env inside containers).
NOTION_ACCESS_KEY=

# --- vLLM / local-llm profile (stage 8+) ---
# Bring up with: docker compose --profile local-llm up -d
# Host GPU prerequisites: docs/host_gpu_setup.md
MODEL_NAME=Qwen/Qwen2.5-7B-Instruct-AWQ
VLLM_QUANTIZATION=awq_marlin
MAX_MODEL_LEN=4096
VLLM_GPU_MEMORY_UTILIZATION=0.85
VLLM_MAX_NUM_SEQS=64
# Optional: gated models
HUGGING_FACE_HUB_TOKEN=

# --- Qdrant smoke (host-side scripts) ---
QDRANT_HOST=localhost
QDRANT_GRPC_PORT=6334
QDRANT_HTTP_PORT=6333
