# Example environment for docker compose / local debug.
# Copy to .env and fill in secrets. Never commit .env.

# --- Gateway ---
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
GATEWAY_API_KEY=change-me
GATEWAY_INGESTION_GRPC_ADDR=ingestion:50051
GATEWAY_RAG_GRPC_ADDR=rag_orchestrator:50052
GATEWAY_LITELLM_BASE_URL=http://litellm:4000

# --- Ingestion ---
INGESTION_GRPC_HOST=0.0.0.0
INGESTION_GRPC_PORT=50051
INGESTION_QDRANT_HOST=qdrant
INGESTION_QDRANT_GRPC_PORT=6334
INGESTION_LITELLM_BASE_URL=http://litellm:4000
INGESTION_EMBEDDING_MODEL_ALIAS=embedder-default

# --- RAG Orchestrator ---
RAG_GRPC_HOST=0.0.0.0
RAG_GRPC_PORT=50052
RAG_QDRANT_HOST=qdrant
RAG_QDRANT_GRPC_PORT=6334
RAG_LITELLM_BASE_URL=http://litellm:4000
RAG_EMBEDDING_MODEL_ALIAS=embedder-default
RAG_RERANKER_MODEL_ALIAS=reranker-default
RAG_CHAT_MODEL_ALIAS=chat-default

# --- LiteLLM (stage 3+) ---
# Chat backend: OpenRouter (preferred) and/or OpenAI-compatible keys.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
LITELLM_MASTER_KEY=sk-ragvalod-local
LITELLM_BASE_URL=http://localhost:4000

# --- Qdrant smoke (host-side scripts) ---
QDRANT_HOST=localhost
QDRANT_GRPC_PORT=6334
QDRANT_HTTP_PORT=6333
