# Bitnami Sealed Secrets — encrypt into cluster-only Secret.
# Install controller: https://github.com/bitnami-labs/sealed-secrets
#
#   kubectl create secret generic ragvalod-secrets \
#     --from-literal=GATEWAY_API_KEY=... \
#     --dry-run=client -o yaml | kubeseal -o yaml > sealed-ragvalod-secrets.yaml
#
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: ragvalod-secrets
  namespace: ragvalod
spec:
  encryptedData:
    GATEWAY_API_KEY: AgBy3i...replace-me
    LITELLM_MASTER_KEY: AgBy3i...replace-me
